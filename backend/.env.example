PORT=5000
NODE_ENV=development
BACKEND_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

GEMINI_API_KEY=your_gemini_api_key
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret
SESSION_SECRET=your_session_secret

# --- Self-hosting (phone server over Tailscale) -------------------------
# Leave these unset for local development.
# HOST=100.x.y.z                      # listen only on the phone's Tailscale IP
# SERVE_FRONTEND=true                 # serve frontend/dist from this server (same origin)
# TLS_CERT_FILE=./certs/phone.pem     # HTTPS certificate (from mkcert)
# TLS_KEY_FILE=./certs/phone-key.pem
# ALLOWED_EMAILS=you@gmail.com        # only these Google accounts may sign in
